# Copy to .env and replace the placeholders. Never commit .env.

# OpenRouter API key used by the agent service. Get one at https://openrouter.ai/keys
# Also add it as the GitHub Actions secret OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY

# Django secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Also add it as the GitHub Actions secret DJANGO_SECRET_KEY.
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string

# Django debug flag. Keep False anywhere that is not your laptop.
DJANGO_DEBUG=True

# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Postgres database name.
POSTGRES_DB=rolecanvas

# Postgres owner role: runs Django migrations and owns the schema.
POSTGRES_USER=rolecanvas_owner
POSTGRES_PASSWORD=change-me-owner-password

# Postgres read-only role (SELECT only): used by the agent for dataset queries.
POSTGRES_READONLY_USER=rolecanvas_readonly
POSTGRES_READONLY_PASSWORD=change-me-readonly-password

# Postgres host/port as seen from inside the Compose network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis connection URL as seen from inside the Compose network.
REDIS_URL=redis://redis:6379/0

# Base URL the browser uses to reach the backend and agent.
VITE_BACKEND_URL=http://localhost:8000
VITE_AGENT_URL=http://localhost:8001
